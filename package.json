{
	"name": "ezchrono",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"install:all": "cd backend && bun install && cd ../frontend && bun install",
		"dev:backend": "cd backend && bun --watch src/index.ts",
		"dev:frontend": "cd frontend && bun run dev",
		"test": "cd backend && bun test",
		"typecheck": "cd backend && bun run typecheck",
		"build": "cd frontend && bun run build",
		"start": "cd backend && bun src/index.ts",
		"check": "bun run typecheck && bun test && bunx biome ci frontend && cd frontend && bun run build",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8"
	}
}
